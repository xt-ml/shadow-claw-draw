{
  "background_color": "#0f1419",
  "description": "In-browser Vector & Bitmap Drawing Studio powered by SVG, Canvas 2D, Web Components, WebMCP, and ShadowClaw.",
  "display": "standalone",
  "id": "shadow-claw-draw",
  "name": "ShadowClaw Draw",
  "short_name": "ShadowClaw Draw",
  "scope": ".",
  "start_url": ".",
  "theme_color": "#0f1419",
  "file_handlers": [
    {
      "action": "./",
      "name": "ShadowClaw Draw Vector & Bitmap Files",
      "icons": [
        {
          "src": "assets/icons/192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "image/svg+xml": [".svg"],
        "image/png": [".png", ".apng"],
        "image/gif": [".gif"],
        "application/json": [".scdraw.json", ".scdraw-anim.json"]
      }
    }
  ],
  "share_target": {
    "action": "share/share-target.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/svg+xml",
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/*",
            "application/json",
            "*/*"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "purpose": "any",
      "sizes": "48x48",
      "src": "assets/icons/48.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "72x72",
      "src": "assets/icons/72.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "96x96",
      "src": "assets/icons/96.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "128x128",
      "src": "assets/icons/128.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "152x152",
      "src": "assets/icons/152.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "167x167",
      "src": "assets/icons/167.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "180x180",
      "src": "assets/icons/180.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
