{
  "name": "shadow-claw-draw",
  "version": "1.0.0",
  "description": "ShadowClaw Draw — In-browser Vector, Bitmap & Animation Studio powered by ShadowClaw.",
  "type": "module",
  "homepage": "https://xt-ml.github.io/shadow-claw-draw/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xt-ml/shadow-claw-draw.git"
  },
  "bugs": {
    "url": "https://github.com/xt-ml/shadow-claw-draw/issues"
  },
  "scripts": {
    "build": "npx shadow-claw build --prod",
    "format": "npx prettier -w .",
    "start": "npx shadow-claw dev --open -y",
    "dev": "npx shadow-claw dev --open -y",
    "test": "node --test test/*.test.mjs",
    "check": "npm run check:compat && npm run check:tools",
    "check:compat": "node bin/check-namespace.mjs",
    "check:namespace": "node bin/check-namespace.mjs",
    "check:tools": "node bin/generate-tools.mjs --check",
    "build:tools": "node bin/generate-tools.mjs",
    "skills:index": "node bin/generate-skills-index.mjs"
  },
  "keywords": [
    "shadow-claw",
    "draw",
    "svg",
    "vector",
    "bitmap",
    "animation",
    "gif",
    "apng",
    "canvas",
    "inkscape",
    "gimp",
    "mcp",
    "webmcp"
  ],
  "license": "AGPL-3.0",
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
